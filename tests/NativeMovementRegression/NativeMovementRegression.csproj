<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <BossModAssembly Condition="'$(BossModAssembly)' == ''">../../BossMod/bin/Release/BossModReborn.dll</BossModAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json" HintPath="$(DALAMUD_HOME)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="BossModReborn" HintPath="$(BossModAssembly)" Private="false" />
    <Reference Include="Dalamud" HintPath="$(DALAMUD_HOME)/Dalamud.dll" Private="false" />
  </ItemGroup>
</Project>
