<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BMR_DLL Condition="'$(BMR_DLL)' == ''">../../BossMod/bin/Release/BossModReborn.dll</BMR_DLL>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DALAMUD_HOME Condition="'$(DALAMUD_HOME)' == ''">$(HOME)/.xlcore/dalamud/Hooks/dev</DALAMUD_HOME>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BossModReborn" HintPath="$(BMR_DLL)" Private="false" />
    <Reference Include="Lumina" HintPath="$(DALAMUD_HOME)/Lumina.dll" Private="false" />
    <Reference Include="Lumina.Excel" HintPath="$(DALAMUD_HOME)/Lumina.Excel.dll" Private="false" />
  </ItemGroup>
</Project>
